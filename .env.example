# ============================================================================
# eSchool — Frontend (Next.js). Variables d'environnement (exemple)
# Copier vers .env.local puis remplir. NE JAMAIS committer .env.local.
# En production (Vercel) : définir ces variables dans Project Settings > Env.
#
# Architecture : ce frontend appelle l'API eschool-api (NestJS), qui utilise
# Supabase (PostgreSQL) comme base de données via Prisma. Le frontend ne parle
# donc PAS directement à Supabase ni ne détient de secrets de base/paiement.
# ============================================================================

# URL de l'API eschool-api. Doit inclure le préfixe global /api/v1.
# En prod : l'URL publique du backend déployé (Railway/Render/Vercel/…).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Clé de stockage du JWT (utilisée en localStorage pour le header Bearer et
# en cookie pour l'application des règles d'accès par le middleware Next).
NEXT_PUBLIC_JWT_STORAGE_KEY=eschool_token

# Application
NEXT_PUBLIC_APP_NAME=eSchool
NEXT_PUBLIC_APP_URL=http://localhost:3000
