# ============================================================================
# eSchool — Variables d'environnement (exemple)
# Copier vers .env.local puis remplir. NE JAMAIS committer .env.local.
# En production (Vercel) : définir ces variables dans Project Settings > Env.
# ============================================================================

# --- Supabase -----------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# ⚠️ SECRET — côté serveur uniquement. Contourne la RLS. Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# --- Application --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=eSchool
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Paiements : Orange Money (Cameroun) --------------------------------------
# ⚠️ SECRETS — côté serveur uniquement.
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

# --- Paiements : MTN Mobile Money (MoMo) --------------------------------------
# ⚠️ SECRETS — côté serveur uniquement.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_WEBHOOK_SECRET=

# --- Paiements : Carte bancaire (PSP) -----------------------------------------
# Fournisseur à confirmer (Stripe / autre agrégateur compatible carte).
# ⚠️ Aucune donnée de carte (PAN/CVV) n'est stockée : tokenisation côté PSP (PCI-DSS).
CARD_PSP_PUBLIC_KEY=
CARD_PSP_SECRET_KEY=
CARD_PSP_WEBHOOK_SECRET=

# --- Email (notifications, reçus) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@eschool.com
